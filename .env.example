# Copy this file to ".env" and fill in real values before running the server.

# Port the server listens on (most hosts set this automatically — you usually don't need to change it)
PORT=3000

# A long random secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Comma-separated usernames that should automatically become admins the moment
# they register. Add your own username here BEFORE you create your account.
ADMIN_USERNAMES=your_username_here
